{
  "nombre_proyecto": "CorporacionFavorita (Poryecto Analisis de datos)",
  "version": "1.0.2 (Prueba Github Actions)",
  "entorno": "Azure VM (Ubuntu Server)",
  "orquestador": "Apache Airflow via Docker",
  "procesamiento": "Polars (Python)",
  "database": "PostgreSQL",
  "estructura_pipeline": {
    "nombre_dag": "pipeline_migracion_la_favorita",
    "schedule": "Manual (None)",
    "pasos": [
      {
        "task_id": "descargar_datos",
        "script_path": "dags/scripts/descargar.py",
        "function": "ejecutar_descarga"
      },
      {
        "task_id": "limpiar_datos",
        "script_path": "dags/scripts/limpiar.py",
        "function": "ejecutar_limpieza"
      },
      {
        "task_id": "transformar_datos",
        "script_path": "dags/scripts/transformar.py",
        "function": "ejecutar_transformacion"
      },
      {
        "task_id": "validar_calidad",
        "script_path": "dags/scripts/validar.py",
        "function": "ejecutar_validacion"
      },
      {
        "task_id": "cargar_postgres",
        "script_path": "dags/scripts/cargar.py",
        "function": "ejecutar_carga"
      },
      {
        "task_id": "generar_reporte",
        "script_path": "dags/scripts/reporte.py",
        "function": "ejecutar_reporte"
      }
    ]
  }
}
